# Used ONLY by `docker compose` (variable substitution in docker-compose.yml).
# Local `npm run dev` does not read this file: see server/.env.example and client/.env.example.
CLIENT_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Private address reachable from the Next container.
API_URL=http://server:4000
# Required for the API. Generate at least 32 random bytes; see server/.env.example.
AUTH_JWT_SECRET=
# false for HTTP Compose, true when the browser uses HTTPS.
AUTH_COOKIE_SECURE=false

# MySQL. The values are applied when the data volume is first created:
# after changing them run `docker compose down -v` (this deletes the database).
DB_ROOT_PASSWORD=root
DB_NAME=dzencode
DB_USER=dzencode
DB_PASSWORD=dzencode
