# Next.js loads client/.env.local automatically. Copy this file to client/.env.local to override.
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Private runtime address used only by Next's server-side inventory requests.
API_URL=http://localhost:4000
# HttpOnly auth cookie: false only for local HTTP, true for HTTPS (production defaults to true).
AUTH_COOKIE_SECURE=false
