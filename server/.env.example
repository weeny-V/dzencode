# Loaded by `npm run dev` / `npm start` in server/ via Node's --env-file-if-exists.
# Copy to server/.env to override the defaults.
HOST=0.0.0.0
PORT=4000
CLIENT_ORIGIN=http://localhost:3000
# Required. Generate a persistent random value: node -e "console.info(require('node:crypto').randomBytes(32).toString('hex'))"
# Never commit a real secret. Changing it invalidates all JWTs.
AUTH_JWT_SECRET=

# MySQL from `docker compose up -d db liquibase` (the defaults match docker-compose.yml).
# Integration tests use the `<DB_NAME>_test` database.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dzencode
DB_USER=dzencode
DB_PASSWORD=dzencode
